# From your Yahoo developer app (https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Random string, 32+ chars, used to encrypt every token this server issues.
# Generate with: openssl rand -base64 48
TOKEN_SECRET=

# Optional: your production URL. Yahoo's redirect URI must be <PUBLIC_URL>/oauth/callback.
# Defaults to Vercel's production domain.
PUBLIC_URL=

# Optional: default league so you don't have to name it in every request.
YAHOO_LEAGUE_ID=

# Optional but recommended: comma-separated Yahoo account GUIDs allowed to connect.
# After you first connect, find your GUID in the Vercel function logs ("Yahoo login: guid=...").
ALLOWED_YAHOO_GUIDS=
